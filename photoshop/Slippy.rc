// Windows resources for Slippy.8li: the PiPL (the same PiPLs.json the Mac
// bundle carries, as the JSON_PIPL resource Photoshop looks for) and version info.
#include <windows.h>
#include "SlippyVersion.h"

JSON_PIPL JSON "PiPLs.json"

1 VERSIONINFO
 FILEVERSION SLIPPY_VERSION_COMMAS
 PRODUCTVERSION SLIPPY_VERSION_COMMAS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Slippy - lets agents drive Photoshop"
            VALUE "FileVersion", SLIPPY_VERSION_STRING
            VALUE "InternalName", "Slippy"
            VALUE "OriginalFilename", "Slippy.8li"
            VALUE "ProductName", "Slippy"
            VALUE "ProductVersion", SLIPPY_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
