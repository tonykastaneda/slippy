{
	"manifestVersion": 5,
	"id": "com.slippy.photoshop",
	"name": "Slippy",
	"version": "0.1.0",
	"main": "index.html",
	"host": { "app": "PS", "minVersion": "26.0.0" },
	"entrypoints": [
		{
			"type": "panel",
			"id": "slippy",
			"label": { "default": "Slippy" },
			"minimumSize": { "width": 240, "height": 300 },
			"maximumSize": { "width": 2000, "height": 4000 },
			"preferredDockedSize": { "width": 320, "height": 520 },
			"preferredFloatingSize": { "width": 320, "height": 520 },
			"icons": [
				{ "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["all"], "species": ["chrome"] }
			]
		}
	],
	"icons": [
		{ "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
	],
	"requiredPermissions": {
		"network": { "domains": ["ws://127.0.0.1:47710", "ws://localhost:47710"] },
		"clipboard": "readAndWrite",
		"localFileSystem": "fullAccess"
	}
}
