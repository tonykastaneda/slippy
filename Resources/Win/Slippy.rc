// Windows resources for Slippy.aip: the PiPL (generated at build time by
// the SDK's create_pipl.py into the build directory) and version info.
#include <windows.h>
#include "SlippyVersion.h"

plugin pipl "plugin.pipl"

IDToFile txt "IDToFile.txt"
slippy_panel_light svg "slippy_panel_light.svg"
slippy_panel_dark svg "slippy_panel_dark.svg"

1 VERSIONINFO
 FILEVERSION SLIPPY_VERSION_COMMAS
 PRODUCTVERSION SLIPPY_VERSION_COMMAS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Slippy - lets agents drive Illustrator"
            VALUE "FileVersion", SLIPPY_VERSION_STRING
            VALUE "InternalName", "Slippy"
            VALUE "OriginalFilename", "Slippy.aip"
            VALUE "ProductName", "Slippy"
            VALUE "ProductVersion", SLIPPY_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
